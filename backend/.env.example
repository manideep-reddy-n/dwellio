# Copy to `.env` and create profile files `.env.local` / `.env.production`

SPRING_PROFILES_ACTIVE=local

JWT_SECRET=change-me-use-at-least-32-characters-long-secret
JWT_ACCESS_TOKEN_EXPIRATION=PT15M
JWT_REFRESH_TOKEN_EXPIRATION=P30D
PORT=8081

CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dwellio.local

# --- .env.local (development) ---
# DATABASE_URL=jdbc:postgresql://localhost:5432/dwellio
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres
# SEED_DEMO_DATA=true
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# APP_PUBLIC_URL=http://localhost:3000

# --- .env.production (Supabase session pooler) ---
# Full URI from Supabase dashboard works (@ in password must be %40):
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-<region>.pooler.supabase.com:5432/postgres
# DATABASE_SCHEMA=dwellio
# SEED_DEMO_DATA=false
# CORS_ALLOWED_ORIGINS=https://your-domain.com
# APP_PUBLIC_URL=https://your-domain.com
