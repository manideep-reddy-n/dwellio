# =============================================================================
# Shared secrets (copy to backend/.env — used by all profiles locally)
# On Render: set these as Environment Variables on the dwellio-api service.
# =============================================================================

JWT_SECRET=change-me-use-at-least-32-characters-long-secret
JWT_ACCESS_TOKEN_EXPIRATION=PT15M
JWT_REFRESH_TOKEN_EXPIRATION=P30D

CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dwellio.local

# Do NOT set PORT on Render — the platform injects it.
# Do NOT set SPRING_PROFILES_ACTIVE here.

# =============================================================================
# Local development → save as backend/.env.local
# =============================================================================
# SPRING_PROFILES_ACTIVE=local
# DATABASE_URL=jdbc:postgresql://localhost:5432/dwellio
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres
# SEED_DEMO_DATA=true
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# APP_PUBLIC_URL=http://localhost:3000

# =============================================================================
# Production (Render / Supabase) → set on Render dashboard OR backend/.env.production
# =============================================================================
# SPRING_PROFILES_ACTIVE=production
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-<region>.pooler.supabase.com:5432/postgres
# DATABASE_SCHEMA=dwellio
# SEED_DEMO_DATA=false
# CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com
# APP_PUBLIC_URL=https://your-frontend.onrender.com
