# Copy to backend/.env — Supabase is the only database (local dev + production).
# On Render: set the same variable names in the dashboard (no .env file needed).

# --- Supabase (session pooler URI — @ in password must be %40) ---
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-<region>.pooler.supabase.com:5432/postgres
DATABASE_SCHEMA=dwellio

# --- Auth ---
JWT_SECRET=change-me-use-at-least-32-characters-long-secret
JWT_ACCESS_TOKEN_EXPIRATION=PT15M
JWT_REFRESH_TOKEN_EXPIRATION=P30D

# --- App ---
PORT=8081
SEED_DEMO_DATA=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000

# --- Integrations (optional) ---
CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dwellio.local

# --- Production overrides (Render dashboard) ---
# CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com
# APP_PUBLIC_URL=https://your-frontend.onrender.com
# Do NOT set PORT on Render — the platform injects it.
