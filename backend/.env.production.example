# Production template — copy values to Render dashboard (do not commit real secrets)

SPRING_PROFILES_ACTIVE=production

# Full Supabase session pooler URI (@ in password → %40)
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-<region>.pooler.supabase.com:5432/postgres
DATABASE_SCHEMA=dwellio

SEED_DEMO_DATA=false
CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com
APP_PUBLIC_URL=https://your-frontend.onrender.com

# Also set on Render (from backend/.env):
# JWT_SECRET, CLOUDINARY_URL, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT
